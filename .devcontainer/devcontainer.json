// For format details, see https://aka.ms/devcontainer.json. For config appions, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Existing Dockerfile",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile",
		"options": [
			"--progress=plain"
			// "--no-cache-filter=cacher"
		]
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment the next line to run commands after the container is created.
	// "postCreateCommand": "cat /etc/os-release",
	"initializeCommand": "export DEVICE_IP=$(ping -c1 rr-100-07.local | grep PING | awk '{print $3}' | tr -d '()') || export DEVICE_IP=192.168.0.115",
    "postStartCommand": "/usr/local/bin/post_start.sh",

	// Configure tool-specific properties.
	// "customizations": {},

	"otherPortsAttributes": {
		"onAutoForward": "ignore"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-iot.vscode-ros",
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"redhat.vscode-xml",
				"redhat.vscode-yaml"
			]
		}
	},

	"privileged": true,
	"runArgs": [
		"--net=host",
		"--gpus=all",
		"--name=rr-ur-integration"
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM": "1",
		"NVIDIA_DRIVER_CAPABILITIES" : "all",
		"XAUTHORITY" : "${localEnv:XAUTHORITY}"
	},
	"mounts": [
		{
			"source": "${localEnv:HOME}/.gazebo",
			"target": "/root/.gazebo/",
			"type": "bind"
		}
	]
	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "devcontainer"
}
